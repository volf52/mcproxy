{
  // Example configuration with both HTTP and stdio endpoints
  "endpoints": {
    // HTTP endpoint that forwards to httpbin.org
    "httpbin": {
      "type": "http",
      "url": "https://httpbin.org/post",
      "headers": {
        "Authorization": "Bearer {{ API_TOKEN }}",
        "Content-Type": "application/json",
        "User-Agent": "mcproxy/1.0",
        "X-Custom-Header": "{{ CUSTOM_HEADER_VALUE }}"
      },
      "timeout": "30s",
      "maxBodySize": 5242880
    },

    // Another HTTP endpoint for echo service
    "echo": {
      "type": "http",
      "url": "https://httpbin.org/echo",
      "headers": {
        "X-API-Key": "{{ ECHO_API_KEY }}",
        "X-Source": "mcproxy"
      },
      "timeout": "15s"
    },

    // Stdio MCP endpoint for filesystem access
    "filesystem": {
      "type": "stdio",
      "command": "/usr/bin/env bunx",
      "args": ["-y", "@modelcontextprotocol/server-filesystem", "/tmp"],
      "env": {
        "NODE_ENV": "production",
        "LOG_LEVEL": "{{ LOG_LEVEL }}",
        "MCP_DEBUG": "{{ MCP_DEBUG_FLAG }}"
      },
      "timeout": "45s",
      "maxBodySize": 10485760
    }
  },

  "globalTimeout": 60000000000,
  "globalMaxBodySize": 10485760,
  "logFile": "",
  "server": {
    "readTimeout": 30,
    "writeTimeout": 30,
    "idleTimeout": 120,
    "shutdownTimeout": 30
  }
}
